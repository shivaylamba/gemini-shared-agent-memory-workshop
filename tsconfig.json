{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core-app/**/*.ts",
    "agent-harness/**/*.ts",
    "evaluation/**/*.ts",
    "scripts/**/*.ts",
    "solutions/**/*.ts",
    "workshop-ui/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules", ".workshop", "runs", "recordings", "solutions/*/reference-implementation"]
}
