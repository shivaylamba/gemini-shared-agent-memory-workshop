+
+type ErrorResponse = { error: { code: string } };
+type OrderBody = { order: { status: string; refundedAmount: number; refundableAmount: number } };
+
+test('refunds: pending orders return ORDER_NOT_REFUNDABLE without a provider call', async () => {
+  const app = createTestApp();
+  const response = await post(app, '/api/orders/ord_1003/refund', { amount: 100, idempotencyKey: 'refund-request-409' });
+  assert.equal(response.status, 409);
+  assert.equal((response.body as ErrorResponse).error.code, 'ORDER_NOT_REFUNDABLE');
+  assert.equal(app.gateway.callsTo('createRefund').length, 0);
+});
+
+test('refunds: amounts above the refundable amount fail before the provider call', async () => {
+  const app = createTestApp();
+  await payOrder(app, 'ord_1001');
+  const response = await post(app, '/api/orders/ord_1001/refund', { amount: 50_001, idempotencyKey: 'refund-request-422' });
+  assert.equal(response.status, 422);
+  assert.equal((response.body as ErrorResponse).error.code, 'REFUND_EXCEEDS_REFUNDABLE');
+  assert.equal(app.gateway.callsTo('createRefund').length, 0);
+});
+
+test('refunds: multiple partial refunds reach refunded and are recorded in the ledger', async () => {
+  const app = createTestApp();
+  await payOrder(app, 'ord_1001');
+  await post(app, '/api/orders/ord_1001/refund', { amount: 20_000, idempotencyKey: 'refund-step-0001' });
+  const response = await post(app, '/api/orders/ord_1001/refund', { amount: 30_000, idempotencyKey: 'refund-step-0002' });
+  assert.equal(response.status, 201);
+  const order = (response.body as OrderBody).order;
+  assert.equal(order.status, 'refunded');
+  assert.equal(order.refundedAmount, 50_000);
+  assert.equal(order.refundableAmount, 0);
+  const refunds = app.ledger.forOrder('ord_1001').filter((t) => t.type === 'refund');
+  assert.deepEqual(refunds.map((t) => t.amount), [20_000, 30_000]);
+  const calls = app.gateway.callsTo('createRefund');
+  assert.equal(calls.length, 2);
+  assert.equal(calls[0]!.api, 'v2');
+  assert.equal(calls[0]!.payload.amount_paise, 20_000);
+});
+
+test('refunds: replays are idempotent and key reuse with a different amount is rejected', async () => {
+  const app = createTestApp();
+  await payOrder(app, 'ord_1002');
+  const first = await post(app, '/api/orders/ord_1002/refund', { amount: 10_000, idempotencyKey: 'refund-replay-001' });
+  const replay = await post(app, '/api/orders/ord_1002/refund', { amount: 10_000, idempotencyKey: 'refund-replay-001' });
+  assert.equal(replay.status, 201);
+  assert.deepEqual(replay.body, first.body);
+  assert.equal(app.gateway.callsTo('createRefund').length, 1);
+  const reused = await post(app, '/api/orders/ord_1002/refund', { amount: 20_000, idempotencyKey: 'refund-replay-001' });
+  assert.equal(reused.status, 409);
+  assert.equal((reused.body as ErrorResponse).error.code, 'IDEMPOTENCY_KEY_REUSED');
+});
+
+test('refunds: retryable provider errors are retried with the same key; failures change nothing', async () => {
+  const app = createTestApp();
+  await payOrder(app, 'ord_1004');
+  app.gateway.failNext('createRefund', { code: 'TIMEOUT', retryable: true });
+  const ok = await post(app, '/api/orders/ord_1004/refund', { amount: 5_000, idempotencyKey: 'refund-retry-0001' });
+  assert.equal(ok.status, 201);
+  const keys = app.gateway.callsTo('createRefund').map((c) => c.payload.idempotency_key);
+  assert.deepEqual(keys, ['refund-retry-0001', 'refund-retry-0001']);
+
+  app.gateway.failNext('createRefund', { code: 'DECLINED', retryable: false });
+  const failed = await post(app, '/api/orders/ord_1004/refund', { amount: 5_000, idempotencyKey: 'refund-retry-0002' });
+  assert.equal(failed.status, 502);
+  assert.equal((failed.body as ErrorResponse).error.code, 'PAYMENT_PROVIDER_ERROR');
+  const order = await get(app, '/api/orders/ord_1004');
+  assert.equal((order.body as OrderBody).order.refundedAmount, 5_000);
+  assert.equal(app.ledger.forOrder('ord_1004').filter((t) => t.type === 'refund').length, 1);
+});
