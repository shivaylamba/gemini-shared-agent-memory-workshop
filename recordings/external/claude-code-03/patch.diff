 export class RefundService {
   private readonly deps: RefundServiceDeps;
@@ -45,9 +51,66 @@
   }
 
   async refund(input: RefundInput): Promise<RefundResult> {
-    // TODO(workshop): implement the refund operation.
-    void this.deps;
-    void input;
-    throw new Error('RefundService.refund is not implemented yet');
+    const { orders, provider, idempotency, ledger, clock } = this.deps;
+    const scope = `refund:${input.orderId}`;
+    const fingerprint = fingerprintOf({ orderId: input.orderId, amount: input.amount });
+
+    return idempotency.run(scope, input.idempotencyKey, fingerprint, async () => {
+      const order = orders.get(input.orderId);
+      if ((order.status !== 'paid' && order.status !== 'partially_refunded') || !order.chargeId) {
+        throw new AppError('ORDER_NOT_REFUNDABLE', `Order ${order.id} has not been paid`, {
+          orderId: order.id,
+          status: order.status,
+        });
+      }
+
+      const refundableAmount = refundableAmountOf(order);
+      if (input.amount > refundableAmount) {
+        throw new AppError('REFUND_EXCEEDS_REFUNDABLE', 'The refund amount is larger than the remaining refundable amount', {
+          orderId: order.id,
+          amount: input.amount,
+          refundableAmount,
+        });
+      }
+
+      const chargeId = order.chargeId;
+      const providerRefund = await withRetry(
+        () => provider.refund({ chargeId, amount: input.amount, reference: order.id, idempotencyKey: input.idempotencyKey }),
+        { attempts: 3, isRetryable: isRetryableProviderError },
+      ).catch((error: unknown) => {
+        throw providerFailure(error, order.id);
+      });
+
+      // Re-read so a concurrent refund (different key) on the same order is not overwritten.
+      const current = orders.get(order.id);
+      const refundedAmount = current.refundedAmount + providerRefund.amount;
+      const now = clock().toISOString();
+      const saved = orders.save({
+        ...current,
+        refundedAmount,
+        status: refundedAmount >= current.amount ? 'refunded' : 'partially_refunded',
+        updatedAt: now,
+      });
+      const transaction = ledger.record({
+        orderId: order.id,
+        type: 'refund',
+        amount: providerRefund.amount,
+        provider: provider.name,
+        providerReference: providerRefund.providerRefundId,
+        idempotencyKey: input.idempotencyKey,
+        createdAt: now,
+      });
+
+      const refund: Refund = {
+        id: transaction.id,
+        orderId: order.id,
+        amount: transaction.amount,
+        status: 'succeeded',
+        providerRefundId: providerRefund.providerRefundId,
+        idempotencyKey: input.idempotencyKey,
+        createdAt: now,
+      };
+      return { refund, order: toOrderView(saved) };
+    });
   }
 }

