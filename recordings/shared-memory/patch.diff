+    const { orders, provider, idempotency, ledger, clock } = this.deps;
+    const orderId = input.orderId;
+    const amount = parsePositivePaise(input.amount);
+    const idempotencyKey = String(input.idempotencyKey); // Note: parseIdempotencyKey can also be used if invoked from route, but input validation happens here or via helper.
+    const scope = `refund:${orderId}`;
+
+    return idempotency.run(scope, idempotencyKey, fingerprintOf({ orderId, amount }), async () => {
+      const order = orders.get(orderId);
+
+      if (order.status !== 'paid' && order.status !== 'partially_refunded') {
+        throw new AppError('ORDER_NOT_REFUNDABLE', `Order ${order.id} has not been paid`, { orderId: order.id });
+      }
+
+      const refundable = refundableAmountOf(order);
+      if (amount > refundable) {
+        throw new AppError('REFUND_EXCEEDS_REFUNDABLE', `Refund amount ${amount} exceeds refundable amount ${refundable}`, {
+          orderId: order.id,
+          amount,
+          refundableAmount: refundable,
+        });
+      }
+
+      if (!order.chargeId) {
+        throw new AppError('INTERNAL_ERROR', `Paid order ${order.id} is missing chargeId`, { orderId: order.id });
+      }
+
+      const providerRefund = await withRetry(
+        () =>
+          provider.refund({
+            chargeId: order.chargeId!,
+            amount,
+            reference: order.id,
+            idempotencyKey,
+          }),
+        { attempts: 3, isRetryable: isRetryableProviderError },
+      ).catch((error: unknown) => {
+        if (error instanceof AppError) throw error;
+        throw providerRefundFailure(error, order.id);
+      });
+
+      const now = clock().toISOString();
+      const newRefundedAmount = order.refundedAmount + amount;
+      const newStatus = newRefundedAmount === order.amount ? 'refunded' : 'partially_refunded';
+
+      const savedOrder = orders.save({
+        ...order,
+        status: newStatus,
+        refundedAmount: newRefundedAmount,
+        updatedAt: now,
+      });
+
+      const transaction = ledger.record({
+        orderId: order.id,
+        type: 'refund',
+        amount: providerRefund.amount,
+        provider: provider.name,
+        providerReference: providerRefund.providerRefundId,
+        idempotencyKey,
+        createdAt: now,
+      });
+
+      const refund: Refund = {
+        id: transaction.id,
+        orderId: order.id,
+        amount: providerRefund.amount,
+        status: 'succeeded',
+        providerRefundId: providerRefund.providerRefundId,
+        idempotencyKey,
+        createdAt: now,
+      };
+
+      return {
+        refund,
+        order: toOrderView(savedOrder),
+      };
+    });
