+    const { orders, provider, idempotency, ledger, clock } = this.deps;
+    const scope = `refund:${input.orderId}`;
+
+    return idempotency.run(scope, input.idempotencyKey, fingerprintOf({ orderId: input.orderId, amount: input.amount }), async () => {
+      const order = orders.get(input.orderId);
+
+      if (order.status !== 'paid' && order.status !== 'partially_refunded') {
+        throw new AppError('ORDER_NOT_REFUNDABLE', `Order ${order.id} has not been paid`, { orderId: order.id });
+      }
+
+      const refundable = refundableAmountOf(order);
+      if (input.amount > refundable) {
+        throw new AppError('REFUND_EXCEEDS_REFUNDABLE', `Refund amount ${input.amount} exceeds refundable amount ${refundable}`, {
+          orderId: order.id,
+          amount: input.amount,
+          refundableAmount: refundable,
+        });
+      }
+
+      if (!order.chargeId) {
+        throw new AppError('ORDER_NOT_REFUNDABLE', `Order ${order.id} has no charge id`, { orderId: order.id });
+      }
+
+      const providerRefund = await withRetry(
+        () =>
+          provider.refund({
+            chargeId: order.chargeId!,
+            amount: input.amount,
+            reference: order.id,
+            idempotencyKey: input.idempotencyKey,
+          }),
+        { attempts: 3, isRetryable: isRetryableProviderError },
+      ).catch((error: unknown) => {
+        throw refundProviderFailure(error, order.id);
+      });
+
+      const now = clock().toISOString();
+      const newRefundedAmount = order.refundedAmount + input.amount;
+      const newStatus = newRefundedAmount === order.amount ? 'refunded' : 'partially_refunded';
+
+      const saved = orders.save({
+        ...order,
+        status: newStatus,
+        refundedAmount: newRefundedAmount,
+        updatedAt: now,
+      });
+
+      const transaction = ledger.record({
+        orderId: order.id,
+        type: 'refund',
+        amount: providerRefund.amount,
+        provider: provider.name,
+        providerReference: providerRefund.providerRefundId,
+        idempotencyKey: input.idempotencyKey,
+        createdAt: now,
+      });
+
+      const refund: Refund = {
+        id: transaction.id,
+        orderId: order.id,
+        amount: providerRefund.amount,
+        status: 'succeeded',
+        providerRefundId: providerRefund.providerRefundId,
+        idempotencyKey: input.idempotencyKey,
+        createdAt: now,
+      };
+
+      return { refund, order: toOrderView(saved) };
+    });
   }
 }
