# Copy to .env (npm run setup does this for you). Never commit .env.

# ---------------------------------------------------------------------------
# Participation path: antigravity | harness | external | replay
# (npm run setup asks; WORKSHOP_MODE overrides .workshop/config.json)
WORKSHOP_MODE=harness

# ---------------------------------------------------------------------------
# Workshop harness (bring your own key). Select ONE provider:
#   google (default) | openai | anthropic | openrouter | openai-compatible | ollama
MODEL_PROVIDER=google
# Leave empty for the provider default (google: gemini-3.5-flash-lite, paid keys: gemini-3.6-flash; openai: gpt-5.4-mini,
# anthropic: claude-haiku-5-5). openrouter, openai-compatible and ollama need a MODEL_ID.
MODEL_ID=

# Only the selected provider needs a credential.
# Google AI Studio key (https://aistudio.google.com/apikey). New keys start with "AQ.";
# older "AIza…" keys are being phased out by Google. GEMINI_API_KEY also works.
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional OpenAI-compatible provider
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Optional local inference (Ollama's OpenAI-compatible endpoint is used)
OLLAMA_BASE_URL=http://localhost:11434

# Per-run budgets. Both conditions of a comparison use the same values (recorded in metadata.json).
AGENT_MAX_MODEL_REQUESTS=30
AGENT_MAX_TOOL_CALLS=60
AGENT_MAX_RUNTIME_SECONDS=300
# Optional cap on model requests per minute. The Gemini free tier allows 5 per minute (and only about
# 20 per day on 3.x Flash, which is why the default is gemini-3.5-flash-lite). npm run setup sets 5 for Google. Either way, the harness waits when the provider
# answers "rate limit" (429) or "overloaded" (503), and the waiting time is reported
# separately from working time. Waits do not count against AGENT_MAX_RUNTIME_SECONDS.
MODEL_REQUESTS_PER_MINUTE=

# ---------------------------------------------------------------------------
# OpenLore (shared knowledge). Leave OPENLORE_ENDPOINT empty to use the local server.
# OpenLore 0.8.0 listens on all interfaces; every HTTP call requires a token.
OPENLORE_ENDPOINT=
OPENLORE_HTTP_PORT=7420
OPENLORE_SSH_PORT=7422

# Where external-agent workspaces are created (outside this repository).
# Default: ~/shopflow-workshop
WORKSHOP_EXTERNAL_DIR=
